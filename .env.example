# ============================================================
# VISIONGUARD ENVIRONMENT CONFIGURATION (.env)
# ============================================================

# --- SERVER CONFIGURATION ---
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# --- AUTHENTICATION & SECURITY ---
JWT_SECRET=visionguard_super_secret_production_jwt_key_2026_secure
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- DATABASE CONFIGURATION ---
# Optional: If MONGODB_URI is unreachable or not provided,
# the backend gracefully activates an in-memory/JSON fallback store!
MONGODB_URI=mongodb://localhost:27017/visionguard

# --- REDIS CONFIGURATION (OPTIONAL) ---
# Optional: If Redis is unavailable, the backend uses internal memory cache.
REDIS_URL=redis://localhost:6379

# --- AI LLM CONFIGURATION ---
# Gemini API Key (Recommended - Google GenAI SDK with gemini-3.8-flash)
# If left blank, VisionGuard uses high-fidelity heuristic RAG reasoning engine!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI API Key (Alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ML SERVICE CONFIGURATION ---
ML_SERVICE_URL=http://localhost:8000
ML_INFERENCE_FPS=5
ML_DEVICE=cpu

# --- DEMO SIMULATION SETTINGS ---
DEMO_MODE=true
DEMO_TICK_INTERVAL_MS=2000
LOITERING_THRESHOLD_SECONDS=30
STATIONARY_OBJECT_THRESHOLD_SECONDS=45
